# Required: password for the admin web UI
ADMIN_PASSWORD=change-me
# Recommended: keeps admin sessions valid across restarts (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Set to true if you serve the UI over HTTPS (reverse proxy)
COOKIE_SECURE=false

# Optional first-run defaults; everything can also be set in the admin UI (Settings tab)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
